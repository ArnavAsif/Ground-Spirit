<style>
  /* ═══════════════════════════════════════
     TESTIMONIALS — section styles
  ═══════════════════════════════════════ */
  .gw-testimonials {
    background: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    padding-left: 52px;
    padding-right: 52px;
    margin-top: {{ section.settings.margin_top }}px;
    margin-bottom: {{ section.settings.margin_bottom }}px;
  }
  .gw-testimonials .s-inner { max-width: {{ section.settings.content_width }}px; margin: 0 auto}
  .gw-testi-grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns }}, 1fr);
    gap: 20px;
    margin-top: 56px;
  }
  .gw-testi-card {
    border-radius: 7px; padding: 30px;
    transition: border-color .35s, transform .45s cubic-bezier(.22,1,.36,1), box-shadow .45s;
  }
  .gw-testi-card:hover {
    transform: translateY(-5px); box-shadow: 0 24px 52px rgba(0,0,0,.35);
  }
  .gw-testi-stars { letter-spacing: 2px; margin-bottom: 18px; }
  .gw-testi-text {
    font-family: 'Cormorant Garamond', serif; font-style: italic;
    line-height: 1.78; margin-bottom: 22px;
  }
  .gw-testi-author { display: flex; align-items: center; gap: 12px; }
  .gw-testi-av {
    width: 36px; height: 36px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-family: 'Bebas Neue', sans-serif; font-size: .95rem;
    flex-shrink: 0;
  }
  .gw-testi-name { font-size: .78rem; font-weight: 500; }
  .gw-testi-meta { font-size: .65rem; margin-top: 2px; letter-spacing: .04em; }

  @media (max-width: 1060px) { .gw-testi-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 660px)  {
    .gw-testimonials { padding: 72px 24px; }
    .gw-testi-grid   { grid-template-columns: 1fr; }
  }
</style>

<section class="gw-testimonials section" id="{{ section.settings.section_id | default: 'reviews' }}">
  <div class="s-inner">
    <div class="reveal" style="text-align: {{ section.settings.heading_align }};">
      <span class="s-label"
        style="color: {{ section.settings.label_color }};
               font-size: {{ section.settings.label_font_size }}px;">
        {{ section.settings.section_label }}
      </span>
      <h2 class="s-title"
        style="color: {{ section.settings.title_color }};
               font-size: {{ section.settings.title_font_size_desktop }}px;
               font-weight: {{ section.settings.title_font_weight }};">
        {{ section.settings.section_title }}
      </h2>
    </div>

    <div class="gw-testi-grid">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'testimonial' %}
            <div class="gw-testi-card reveal d{{ forloop.index }}"
              style="background: {{ block.settings.card_bg }};
                     border: 1px solid {{ block.settings.card_border }};"
              {{ block.shopify_attributes }}>
              <div class="gw-testi-stars"
                style="color: {{ block.settings.stars_color }};
                       font-size: {{ block.settings.stars_font_size }}px;">
                {% for i in (1..block.settings.star_count) %}★{% endfor %}
              </div>
              <p class="gw-testi-text"
                style="color: {{ block.settings.quote_color }};
                       font-size: {{ block.settings.quote_font_size }}px;
                       line-height: {{ block.settings.quote_line_height }};">
                "{{ block.settings.quote }}"
              </p>
              <div class="gw-testi-author">
                <div class="gw-testi-av"
                  style="background: linear-gradient(135deg, {{ block.settings.avatar_bg_dark }}, {{ block.settings.avatar_bg_light }});
                         color: {{ block.settings.avatar_text_color }};">
                  {{ block.settings.author_name | slice: 0 }}
                </div>
                <div>
                  <div class="gw-testi-name" style="color: {{ block.settings.name_color }};">
                    {{ block.settings.author_name }}
                  </div>
                  <div class="gw-testi-meta" style="color: {{ block.settings.meta_color }};">
                    {{ block.settings.author_meta }}
                  </div>
                </div>
              </div>
            </div>
        {% endcase %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "tag": "section",
  "settings": [
    { "type": "header","content": "Content Controls" },
    { "type": "text",  "id": "section_id",             "label": "Section Anchor ID",          "default": "reviews" },
    { "type": "text",  "id": "section_label",          "label": "Section Label",              "default": "Real Results" },
    { "type": "liquid",  "id": "section_title",          "label": "Section Title",              "default": "What our customers <em>say</em>" },
    { "type": "select","id": "heading_align",          "label": "Heading Alignment",
      "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }], "default": "center" },
    { "type": "header","content": "Typography" },
    { "type": "range", "id": "title_font_size_desktop","label": "Title Font Size (px)",       "min": 24, "max": 80,  "step": 2, "default": 52 },
    { "type": "range", "id": "label_font_size",        "label": "Label Font Size (px)",        "min": 10, "max": 20,  "step": 1, "default": 15 },
    { "type": "select","id": "title_font_weight",      "label": "Title Font Weight",
      "options": [{ "value": "300", "label": "Light" }, { "value": "400", "label": "Regular" }, { "value": "700", "label": "Blod" }], "default": "400" },
    { "type": "header","content": "Color Controls" },
    { "type": "color", "id": "bg_color",               "label": "Background Color",           "default": "#111712" },
    { "type": "color", "id": "title_color",            "label": "Title Color",                 "default": "#f2f5f1" },
    { "type": "color", "id": "label_color",            "label": "Label Color",                 "default": "#8fa889" },
    { "type": "header","content": "Layout Controls" },
    { "type": "range", "id": "columns",                "label": "Columns (desktop)",           "min": 1, "max": 4, "step": 1, "default": 3 },
    { "type": "range", "id": "padding_top",            "label": "Padding Top (px)",            "min": 0, "max": 160, "step": 5, "default": 100 },
    { "type": "range", "id": "padding_bottom",         "label": "Padding Bottom (px)",         "min": 0, "max": 160, "step": 5, "default": 100 },
    { "type": "range", "id": "margin_top",             "label": "Margin Top (px)",             "min": 0, "max": 80,  "step": 4, "default": 0 },
    { "type": "range", "id": "margin_bottom",          "label": "Margin Bottom (px)",          "min": 0, "max": 80,  "step": 4, "default": 0 },
    { "type": "range", "id": "content_width",          "label": "Max Content Width (px)",      "min": 800, "max": 1600, "step": 40, "default": 1440 }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        { "type": "header",  "content": "Review Content" },
        { "type": "textarea","id": "quote",            "label": "Quote",            "default": "Six years of chronic back pain. Two weeks on the Sleep Mat and I woke up without that familiar ache for the first time." },
        { "type": "text",    "id": "author_name",      "label": "Author Name",      "default": "Sarah M." },
        { "type": "text",    "id": "author_meta",      "label": "Author Meta",      "default": "✓ Verified · Portland, OR" },
        { "type": "range",   "id": "star_count",       "label": "Stars",            "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "header",  "content": "Typography" },
        { "type": "range",   "id": "quote_font_size",  "label": "Quote Font Size (px)", "min": 12, "max": 22, "step": 1, "default": 16 },
        { "type": "range",   "id": "quote_line_height","label": "Quote Line Height",    "min": 1.2, "max": 2.4, "step": 0.1, "default": 1.8 },
        { "type": "range",   "id": "stars_font_size",  "label": "Stars Font Size (px)", "min": 10, "max": 22, "step": 1, "default": 13 },
        { "type": "header",  "content": "Color Controls" },
        { "type": "color",   "id": "card_bg",          "label": "Card Background",  "default": "#161e17" },
        { "type": "color",   "id": "card_border",      "label": "Card Border",      "default": "#1e2b1f" },
        { "type": "color",   "id": "stars_color",      "label": "Stars Color",      "default": "#6e7c68" },
        { "type": "color",   "id": "quote_color",      "label": "Quote Color",      "default": "#c7cec5" },
        { "type": "color",   "id": "name_color",       "label": "Name Color",       "default": "#f2f5f1" },
        { "type": "color",   "id": "meta_color",       "label": "Meta Color",       "default": "#6e7c68" },
        { "type": "color",   "id": "avatar_bg_dark",   "label": "Avatar Gradient Start","default": "#4a5645" },
        { "type": "color",   "id": "avatar_bg_light",  "label": "Avatar Gradient End",  "default": "#6e7c68" },
        { "type": "color",   "id": "avatar_text_color","label": "Avatar Text Color", "default": "#080c09" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        { "type": "testimonial", "settings": { "quote": "Six years of chronic back pain. Two weeks on the Sleep Mat and I woke up without that familiar ache for the first time. I genuinely could not believe it.", "author_name": "Sarah M.",      "author_meta": "✓ Verified · Portland, OR" } },
        { "type": "testimonial", "settings": { "quote": "I'm a biochemist. I was thoroughly sceptical. My Oura Ring data proved me wrong — REM sleep up 40% in three weeks.", "author_name": "Dr. David K.", "author_meta": "✓ Verified · London, UK" } },
        { "type": "testimonial", "settings": { "quote": "The desk pad changed everything about my afternoons. Less shoulder tension, calmer focus, and my wrist inflammation from typing is finally subsiding.", "author_name": "Lena W.",       "author_meta": "✓ Verified · Berlin, DE" } }
      ]
    }
  ]
}
{% endschema %}
