{% schema %}
{
  "name": "Circle Text & Logo",
  "settings": [
    {
      "type": "text",
      "id": "my_text",
      "label": "Circle Text",
      "default": "Some text - Animated circle text -"
    },
    {
      "type": "image_picker",
      "id": "my_logo",
      "label": "Circle Logo"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text Size",
      "min": 12,
      "max": 36,
      "default": 17,
      "unit": "px"
      }
  ]
}
{% endschema %}

<div class="circle">
  <div class="my-logo" style="background-image: url({{ section.settings.my_logo | img_url: '512x512' }});"></div>
  <div class="my-text">
    <p style="color: {{ section.settings.text_color }}; font-size: {{ section.settings.text_size }}px;">
      {{ section.settings.my_text }} 
    </p>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    const text = document.querySelector(".my-text p");
    text.innerHTML = text.innerText
      .split("")
      .map(
        (char, i) => `<span style="transform:rotate(${i * 10.3}deg)">${char}</span>`
      )
      .join("");
  });
</script>

<style>
.circle {
  position: relative;
  width: 200px;
  height: 200px;
  border-radius: 100vmax;
  display: flex;
  align-items: center;
  justify-content: center;
}

   @media (max-width: 768px) {
  .circle {
    position: absolute;
    bottom: -23px;
    right: -32px;
    width: 201px;
    height: 200px;
    border-radius: 100vmax;
    display: flex;
    align-items: center;
    justify-content: center;
}}
  
.my-logo {
  position: absolute;
  width: 140px;
  height: 140px;
  background-size: cover;
  border-radius: 100vmax;
  background-position: center;
}

.my-text {
  position: absolute;
  width: 100%;
  height: 100%;
  font-family: consolas;
  animation: textRotation 8s linear infinite;
}

@keyframes textRotation {
  to {
    transform: rotate(360deg);
  }
}

.my-text span {
  position: absolute;
  left: 50%;
  transform-origin: 0 100px;
}
</style>
