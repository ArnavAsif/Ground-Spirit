    { "type": "range",  "id": "title_font_size_desktop", "label": "Title Size Desktop (px)", "min": 24, "max": 80, "step": 2, "default": 40 },
    { "type": "range",  "id": "title_font_size_mobile",  "label": "Title Size Mobile (px)",  "min": 18, "max": 60, "step": 2, "default": 32 },
